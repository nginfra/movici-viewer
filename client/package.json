{
  "name": "movici-viewer",
  "version": "1.1.1",
  "private": true,
  "workspaces": ["movici-flow-lib"],
  "scripts": {
    "predev": "npm run sync:flowlib-static",
    "dev": "vite",
    "build": "run-p type-check build-only",
    "prebuild": "npm run build --workspace @nginfra/movici-flow-lib && npm run sync:flowlib-static",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "sync:flowlib-static": "node -e \"require('node:fs').cpSync('movici-flow-lib/public/static','public/static',{recursive:true})\"",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "format": "prettier --write src/",
    "lint:format": "prettier --check src/"
  },
  "dependencies": {
    "@ckpack/vue-color": "1.6.0",
    "@deck.gl-community/editable-layers": "9.3.7",
    "@deck.gl-community/layers": "9.3.7",
    "@deck.gl/core": "9.3.5",
    "@deck.gl/extensions": "9.3.5",
    "@deck.gl/geo-layers": "9.3.5",
    "@deck.gl/layers": "9.3.5",
    "@deck.gl/mesh-layers": "9.3.5",
    "@luma.gl/constants": "9.3.5",
    "@luma.gl/core": "9.3.5",
    "@luma.gl/engine": "9.3.5",
    "@oruga-ui/oruga-next": "0.13.6",
    "@oruga-ui/theme-bulma": "0.9.0",
    "@placemarkio/geo-viewport": "1.0.2",
    "@turf/helpers": "7.3.1",
    "@turf/nearest-point-on-line": "7.3.1",
    "axios": "1.13.2",
    "bulma": "1.0.4",
    "chartjs-plugin-annotation": "3.1.0",
    "geotiff": "2.1.3",
    "h3-js": "4.4.0",
    "lodash": "4.17.21",
    "mapbox-gl": "3.16.0",
    "@nginfra/movici-flow-lib": "*",
    "pinia": "3.0.4",
    "proj4": "2.20.2",
    "reproject": "1.2.7",
    "vue": "3.5.25",
    "vue-chartjs": "5.3.3",
    "vue-i18n": "11.2.2",
    "vue-router": "4.6.3",
    "vuedraggable": "4.1.0"
  },
  "devDependencies": {
    "@tsconfig/node22": "22.0.2",
    "@types/jsdom": "27.0.0",
    "@types/lodash": "4.17.21",
    "@types/node": "24.10.1",
    "@vitejs/plugin-vue": "6.0.2",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.6.0",
    "@vue/tsconfig": "0.8.1",
    "eslint": "9.37.0",
    "eslint-plugin-vue": "10.5.0",
    "jiti": "2.6.1",
    "jsdom": "22.1.0",
    "npm-run-all2": "8.0.4",
    "prettier": "3.9.4",
    "sass-embedded": "1.93.3",
    "typescript": "5.9.3",
    "vite": "7.2.6",
    "vite-plugin-vue-devtools": "8.0.5",
    "vue-tsc": "3.1.7"
  }
}
